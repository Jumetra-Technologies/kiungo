{
  "name": "kiungo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kiungo Hybrid Simulation: desktop application monorepo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kiungo/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "prepare": "husky || true",
    "qc": "node scripts/qc/qc.mjs",
    "qc:all": "node scripts/qc/qc.mjs --all",
    "qc:selftest": "node --test scripts/qc/__tests__/lint.test.mjs scripts/qc/__tests__/parsers.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "yaml": "^2.6.0"
  }
}
