{
  "name": "@kiungo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Kiungo design tokens, the theme and the interface pieces the website, the lab and the desktop app share.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./assets/*": "./assets/*",
    "./cn": "./src/cn.ts",
    "./views": "./src/views.ts",
    "./clipboard": "./src/clipboard.ts",
    "./use-turntable": "./src/use-turntable.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "4.1.11"
  }
}
