{
  "id": "uno",
  "name": "Arduino Uno",
  "fqbn": "arduino:avr:uno",
  "mcu": "ATmega328P",
  "clockHz": 16000000,
  "flashBytes": 32768,
  "sramBytes": 2048,
  "eepromBytes": 1024,
  "adcBits": 10,
  "adcRefVolts": 5,
  "logicVolts": 5,
  "maxPinMilliamps": 40,
  "emulator": "avr8js",
  "pins": [
    { "id": "D0", "functions": ["digital"], "reserved": true },
    { "id": "D1", "functions": ["digital"], "reserved": true },
    { "id": "D2", "functions": ["digital", "interrupt"] },
    { "id": "D3", "functions": ["digital", "pwm", "interrupt"] },
    { "id": "D4", "functions": ["digital"] },
    { "id": "D5", "functions": ["digital", "pwm"] },
    { "id": "D6", "functions": ["digital", "pwm"] },
    { "id": "D7", "functions": ["digital"] },
    { "id": "D8", "functions": ["digital"] },
    { "id": "D9", "functions": ["digital", "pwm"] },
    { "id": "D10", "functions": ["digital", "pwm"] },
    { "id": "D11", "functions": ["digital", "pwm"] },
    { "id": "D12", "functions": ["digital"] },
    { "id": "D13", "functions": ["digital"] },
    { "id": "A0", "functions": ["digital", "adc"] },
    { "id": "A1", "functions": ["digital", "adc"] },
    { "id": "A2", "functions": ["digital", "adc"] },
    { "id": "A3", "functions": ["digital", "adc"] },
    { "id": "A4", "functions": ["digital", "adc"] },
    { "id": "A5", "functions": ["digital", "adc"] }
  ]
}
