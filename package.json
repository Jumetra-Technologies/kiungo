{
  "name": "kiungo",
  "version": "0.1.0",
  "private": true,
  "description": "Kiungo: the desktop app for building, coding and running robotics projects, and the packages it is built from.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @kiungo/desktop",
    "desktop": "npm run dev -w @kiungo/desktop",
    "build": "npm run build -w @kiungo/desktop",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/desktop",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
